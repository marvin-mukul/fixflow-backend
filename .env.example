NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://fixflow:fixflow@localhost:5432/fixflow
DATABASE_URL_TEST=postgresql://fixflow:fixflow@localhost:5432/fixflow_test
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
SEED_SUPERADMIN_EMAIL=marvin.mukul@rubicotech.in
SEED_SUPERADMIN_PASSWORD=Rubi@123
MAIL_FROM="FixFlow <no-reply@fixflow.local>"
# Brevo transactional API key (xkeysib-...). Empty = emails are logged to the console.
BREVO_API_KEY=
UPLOAD_DIR=./uploads
# local = files on disk under UPLOAD_DIR; s3 = any S3-compatible bucket (Neon, R2, AWS)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
SWAGGER_PUBLIC=true
PAYMENT_PROVIDER=mock
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_WEBHOOK_SECRET=
CASHFREE_API_VERSION=2025-01-01
